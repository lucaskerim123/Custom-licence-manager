# PostgreSQL used by the License Manager itself
DATABASE_URL=postgres://user:password@host:5432/license_manager
# true for hosted PostgreSQL providers; false for local/non-TLS PostgreSQL
DATABASE_SSL=true
# Optional: explicit Supabase regional pooler hostname. If DATABASE_URL uses
# db.<project-ref>.supabase.co, the app automatically uses the current
# ap-southeast-2 pooler unless this variable is supplied.
SUPABASE_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com

# Legacy integration credential. Managed API keys created in the admin UI are
# preferred for Billing Store, installed products, deployment and release clients.
# Never expose as NEXT_PUBLIC_*.
INTEGRATION_API_TOKEN=replace-with-a-long-random-secret

# Optional non-interactive bootstrap. Alternatively deploy and use /setup once.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
