# License Master production database
DATABASE_URL=postgres://user:password@host:5432/license_manager
DATABASE_SSL=true

# Optional Supabase regional pooler hostname.
SUPABASE_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com

# Managed API keys are the primary production integration mechanism.
# Billing Store uses BILLING_API_TOKEN.
# Customer/deployer operations use DEPLOYER_API_TOKEN.
# These env fallbacks are optional emergency/service credentials only.
MASTER_API_TOKEN=replace-with-a-long-random-secret
BILLING_API_TOKEN=replace-with-a-long-random-secret
DEPLOYER_API_TOKEN=replace-with-a-long-random-secret
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Read-only GitHub credential used by the release artifact proxy when the Base repository is private.
GITHUB_RELEASE_TOKEN=github-fine-grained-read-token

# Optional non-interactive bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# Fine-grained GitHub token used by the License Manager Operations control plane.
# Required: Actions read/write, Contents read for both repositories.
GITHUB_ACTIONS_TOKEN=github-actions-write-token
