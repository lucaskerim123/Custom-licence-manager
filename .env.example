# ============================================================
# ORBITFS LICENSE MANAGER — PRODUCTION ENVIRONMENT
# Runtime: Vercel production
# Never commit real secret values to Git.
# ============================================================

# ----------------------------
# Database / Supabase
# ----------------------------
DATABASE_URL=postgres://user:password@host:5432/license_manager
DATABASE_SSL=true
SUPABASE_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com

# ----------------------------
# License Manager API credentials
# Stable service credentials. Keep unchanged until intentionally rotated.
# ----------------------------
MASTER_API_TOKEN=replace-with-stable-master-api-token
BILLING_API_TOKEN=replace-with-stable-billing-api-token
DEPLOYER_API_TOKEN=replace-with-stable-deployer-api-token
ADMIN_API_TOKEN=replace-with-stable-admin-api-token

# ----------------------------
# GitHub release/artifact access
# ----------------------------
GITHUB_RELEASE_TOKEN=replace-with-github-release-read-token

# Legacy compatibility for the older artifact proxy route.
# Set to the same value as GITHUB_RELEASE_TOKEN until that route is removed.
GITHUB_TOKEN=replace-with-same-value-as-github-release-token

# GitHub control-plane token used by License Manager Operations.
# Required: Actions read/write + Contents read for controlled repositories.
GITHUB_ACTIONS_TOKEN=replace-with-github-actions-control-token

# ----------------------------
# Legacy integration compatibility
# ----------------------------
# Existing fallback for older integration authorization.
# New integrations should use managed API keys instead.
INTEGRATION_API_TOKEN=replace-with-legacy-integration-token

# ----------------------------
# Initial admin bootstrap
# ----------------------------
# Only required when running the bootstrap-admin script.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-bootstrap-password
