# ============================================================
# ORBITFS LICENSE MANAGER — PRODUCTION ENVIRONMENT
# ============================================================
# Runtime: Vercel Production
# Authority: technical license + release authority
#
# NEVER commit real secrets to Git.
# Stable credentials are intentionally reused across connected
# systems until an intentional rotation/revocation is performed.
# ============================================================

# ============================================================
# 01 — DATABASE / SUPABASE
# Same database/project used by the OrbitFS platform systems.
# ============================================================
DATABASE_URL=postgres://user:password@host:5432/license_manager
DATABASE_SSL=true
SUPABASE_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com

# ============================================================
# 02 — LICENSE MANAGER API CREDENTIALS
# Master = License Manager service authority.
# Billing = Billing Store service identity.
# Deployer = deployment service identity.
# Admin = administrative/API fallback authorization.
# ============================================================
MASTER_API_TOKEN=replace-with-stable-master-api-token
BILLING_API_TOKEN=replace-with-stable-billing-api-token
DEPLOYER_API_TOKEN=replace-with-stable-deployer-api-token
ADMIN_API_TOKEN=replace-with-stable-admin-api-token

# ============================================================
# 03 — GITHUB RELEASE / ARTIFACT ACCESS
# Used by License Manager to inspect/download release artifacts.
# ============================================================
GITHUB_RELEASE_TOKEN=replace-with-stable-github-release-token

# Legacy artifact-proxy compatibility.
# Keep identical to GITHUB_RELEASE_TOKEN until the old route is removed.
GITHUB_TOKEN=replace-with-same-value-as-github-release-token

# ============================================================
# 04 — GITHUB ACTIONS CONTROL PLANE
# Used by License Manager Operations to read/dispatch controlled
# GitHub workflows.
# Required permissions: Actions read/write + Contents read.
# ============================================================
GITHUB_ACTIONS_TOKEN=replace-with-stable-github-actions-control-token

# ============================================================
# 05 — LEGACY INTEGRATION COMPATIBILITY
# Older authorization fallback only.
# New integrations should use the managed API credentials above.
# ============================================================
INTEGRATION_API_TOKEN=replace-with-legacy-integration-token

# ============================================================
# 06 — INITIAL ADMIN BOOTSTRAP
# Only needed when running the bootstrap-admin/setup process.
# Do NOT use these as normal runtime credentials.
# ============================================================
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-bootstrap-password

# ============================================================
# 07 — AUTOMATIC PLATFORM VALUES
# Supplied by Vercel/GitHub at runtime/workflow time.
# Do not manually create these as application secrets.
# ============================================================
# VERCEL_GIT_COMMIT_SHA=<provided-by-vercel>
# GITHUB_TOKEN=<provided-by-github-actions>
#
# Deployment-only values belong in GitHub Actions secrets/variables:
#   Secret: VERCEL_TOKEN
#   Secret: GITHUB_ACTIONS_TOKEN
#   Variable: VERCEL_ORG_ID
#   Variable: VERCEL_PROJECT_ID
# ============================================================
