# ORBITFS CUSTOM LICENSE MANAGER — PRODUCTION ENVIRONMENT
# License Master is the TOP technical authority.
# Managed API keys are created, scoped, rotated and revoked here.
# Downstream systems receive only the specific managed key they need.
# Never commit real secrets.

DATABASE_URL=postgres://user:password@host:5432/license_manager
DATABASE_SSL=true
SUPABASE_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com

# Optional machine-key fallbacks. Prefer managed API keys stored in License Master.
# MASTER_API_TOKEN stays inside License Master and is NEVER copied downstream.
MASTER_API_TOKEN=replace-with-license-master-master-fallback
BILLING_API_TOKEN=replace-with-billing-managed-key-fallback
DEPLOYER_API_TOKEN=replace-with-deployer-managed-key-fallback
ADMIN_API_TOKEN=replace-with-admin-managed-key-fallback

GITHUB_RELEASE_TOKEN=replace-with-stable-github-release-token
GITHUB_TOKEN=replace-with-same-value-as-github-release-token
GITHUB_ACTIONS_TOKEN=replace-with-stable-github-actions-control-token

# Legacy only. New integrations use managed API keys.
INTEGRATION_API_TOKEN=replace-with-legacy-integration-token

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-bootstrap-password

# MANAGED INTEGRATION MAP
# Create/scoped/rotate these in License Master, then copy ONLY the generated
# integration key to its destination secret store:
#
# Dev Panel:
#   LICENSE_MASTER_API_TOKEN = release-control integration key
#
# V1 Base workflow:
#   LICENSE_MASTER_API_TOKEN = release/build integration key
#
# V1 Engine workflow:
#   LICENSE_MASTER_API_TOKEN = release/build integration key
#
# V2 Billing Store:
#   BILLING_API_TOKEN  = billing/licensing/release integration key
#   DEPLOYER_API_TOKEN = deployment/update integration key
#
# Separate scoped keys are preferred. A single managed key may only be reused
# where its License Master scopes explicitly cover both operations.
#
# GitHub/Vercel deployment credentials such as VERCEL_TOKEN are NOT License
# Master API keys and remain in the appropriate GitHub/Vercel secret store.
