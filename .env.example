# PostgreSQL used by the License Master itself
DATABASE_URL=postgres://user:password@host:5432/license_manager
# true for hosted PostgreSQL providers; false for local/non-TLS PostgreSQL
DATABASE_SSL=true
# Optional: explicit Supabase regional pooler hostname.
SUPABASE_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com

# Legacy integration credential. Managed API keys created in the admin UI are preferred.
# Never expose as NEXT_PUBLIC_*.
INTEGRATION_API_TOKEN=replace-with-a-long-random-secret

# Optional machine-key fallbacks. Managed API keys are preferred for Billing Store,
# deployment clients and release automation. These may all be the same key when
# the corresponding managed API key has the required scopes.
MASTER_API_TOKEN=replace-with-a-long-random-secret
BILLING_API_TOKEN=replace-with-a-long-random-secret
DEPLOYER_API_TOKEN=replace-with-a-long-random-secret
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Read-only GitHub credential used by the release artifact proxy when the Base
# repository is private. Fine-grained Contents: Read-only for V1-vercel-base.
GITHUB_RELEASE_TOKEN=github-fine-grained-read-token

# Optional non-interactive bootstrap. Alternatively deploy and use /setup once.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
